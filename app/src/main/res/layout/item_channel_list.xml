<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_channel_item_default">

    <!-- Number -->
    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="@color/colorOrange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Logo rounded-square dark bg -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="14dp"
        android:elevation="3dp">

        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_channel_logo" />

        <!-- First-letter gradient avatar (shown when the playlist has no logo) -->
        <TextView
            android:id="@+id/tvLetter"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:textColor="@color/colorChannelName"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_letter_avatar" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <!-- Channel Name -->
    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/colorChannelName"
        android:textSize="15sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
