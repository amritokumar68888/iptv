<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_channel_card"
    android:padding="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Top row: name + letter avatar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorChannelName"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginEnd="6dp" />

        <!-- First letter avatar -->
        <TextView
            android:id="@+id/tvLetter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textColor="@color/colorChannelName"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_letter_avatar" />

    </LinearLayout>

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/colorDivider" />

    <!-- EPG / Program info -->
    <TextView
        android:id="@+id/tvEpg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_program"
        android:textColor="@color/colorEpgText"
        android:textSize="11sp"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
