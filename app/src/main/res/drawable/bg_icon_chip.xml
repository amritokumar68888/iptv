<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#40FF9A3C"
                android:endColor="#40E8388A" />
            <stroke android:width="1.5dp" android:color="@color/colorOrange" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#33FF9A3C"
                android:endColor="#33E8388A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
