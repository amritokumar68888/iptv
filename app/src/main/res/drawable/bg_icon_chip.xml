<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_icon_chip_active" />
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#33FF9A3C"
                android:endColor="#33E8388A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
