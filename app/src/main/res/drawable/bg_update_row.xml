<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus/hover: 4-side gradient border -->
    <item android:state_focused="true" android:drawable="@drawable/bg_channel_item_focused" />
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#33FF9A3C"
                android:endColor="#33E8388A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default: subtle gradient card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/colorGradientCardStart"
                android:endColor="@color/colorGradientCardEnd"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/colorDivider" />
        </shape>
    </item>
</selector>
